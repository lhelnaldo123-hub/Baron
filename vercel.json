{
  "functions": {
    "api/voice.js": {
      "maxDuration": 45
    },
    "api/look.js": {
      "maxDuration": 30
    },
    "api/mail.js": {
      "maxDuration": 30
    },
    "api/speak.js": {
      "maxDuration": 30
    },
    "api/telegram.js": {
      "maxDuration": 45
    },
    "api/notify.js": {
      "maxDuration": 45
    },
    "api/search.js": {
      "maxDuration": 20
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/notify?mode=morning",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/notify?mode=evening",
      "schedule": "0 19 * * *"
    }
  ]
}